# flux-3-klein-iq8r.recipe -- FLUX.3 [klein] (or its base) with IQ8R linears.
#
#   rad-convert <flux-3-image-klein pipeline directory> --recipe data/recipes/flux-3-klein-iq8r.recipe \
#       -o flux-3-klein-iq8r.rad
#
# Every linear of the text encoder's language model and of the DiT's early and joint blocks
# becomes rotated int8: codes in -127..127 in the 128-wide Hadamard domain with a u8 scale per
# [1 x 256] of K under a bf16 scale a row, read at i8a8h against int8 activations quantised under
# the same rotation with one scale per (token, 256). Round to nearest with a scale search; no
# calibration data is read. What stays bf16 is read once a pass or less: the embedding table, the
# embedders, the timestep MLPs, the modulations, the output layer and the VAE. The language
# model's layers past its last tap (32 of 36) are not carried.

te.blk.*.attn_qkv.weight             rtn  codes=i8 group=256 scale=u8 scale2=bf16 block2=1x* transform=fwht128 clamp=sym rule=search
te.blk.*.attn_output.weight          rtn  codes=i8 group=256 scale=u8 scale2=bf16 block2=1x* transform=fwht128 clamp=sym rule=search
te.blk.*.ffn_gate_up.weight          rtn  codes=i8 group=256 scale=u8 scale2=bf16 block2=1x* transform=fwht128 clamp=sym rule=search
te.blk.*.ffn_down.weight             rtn  codes=i8 group=256 scale=u8 scale2=bf16 block2=1x* transform=fwht128 clamp=sym rule=search
dit.mode.*.attn_qkv.weight           rtn  codes=i8 group=256 scale=u8 scale2=bf16 block2=1x* transform=fwht128 clamp=sym rule=search
dit.mode.*.attn_output.weight        rtn  codes=i8 group=256 scale=u8 scale2=bf16 block2=1x* transform=fwht128 clamp=sym rule=search
dit.mode.*.ffn_in.weight             rtn  codes=i8 group=256 scale=u8 scale2=bf16 block2=1x* transform=fwht128 clamp=sym rule=search
dit.mode.*.ffn_out.weight            rtn  codes=i8 group=256 scale=u8 scale2=bf16 block2=1x* transform=fwht128 clamp=sym rule=search
dit.single.*.attn_qkv.weight         rtn  codes=i8 group=256 scale=u8 scale2=bf16 block2=1x* transform=fwht128 clamp=sym rule=search
dit.single.*.attn_output.weight      rtn  codes=i8 group=256 scale=u8 scale2=bf16 block2=1x* transform=fwht128 clamp=sym rule=search
dit.single.*.ffn_in.weight           rtn  codes=i8 group=256 scale=u8 scale2=bf16 block2=1x* transform=fwht128 clamp=sym rule=search
dit.single.*.ffn_out.weight          rtn  codes=i8 group=256 scale=u8 scale2=bf16 block2=1x* transform=fwht128 clamp=sym rule=search
vae.*                                cast dtype=bf16
