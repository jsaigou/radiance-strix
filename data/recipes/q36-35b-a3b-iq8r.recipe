# q36-35b-a3b-iq8r.recipe -- Qwen3.6-35B-A3B from its bf16 release with an IQ8R trunk and int8
# experts, served by qwen35moe_w8a8.
#
#   rad-convert <Qwen3.6-35B-A3B bf16 checkpoint> --recipe data/recipes/q36-35b-a3b-iq8r.recipe \
#       --set quantization_config.quant_method=w8a8 --set quantization_config.fmt=fwht128 \
#       -o q36-35b-a3b-iq8r.rad
#
# The --set keys make the container's descriptor `w8a8_fwht128`, which selects qwen35moe_w8a8.
#
#   - IQ8R: every trunk linear (attention q/gate, k, v and output, the delta net's qkv/z and
#     output; the MTP layer's too) as int8 codes in -127..127 with one u8 scale per (row, 256 of
#     K) under one bf16 scale a row, each 128 of K rotated by the unnormalised Hadamard before
#     rounding and the 1/128 kept in the row scale (`transform=fwht128`). Round to nearest with a
#     scale search; no calibration data is read.
#   - The 256 routed experts of every layer as int8 on the same rotated grid with one bf16 scale
#     per (row, 128 of K): an expert is 512 columns, 256 a rank on two cards and 128 on four, so
#     its scale groups are the 128 that every split leaves whole. The grouped GEMM reads them at
#     i8a8h against the int8 codes the trunk's quantisers write (moe_gemm_i8a8).
#   - The shared expert is a trunk linear pair: its gate/up projection IQ8R, reading the same
#     codes as the attention does, and its down projection at the experts' 128, its K being the
#     expert's width.
#   - The router, the shared expert's gate, the delta net's a/b projections, the norms, the
#     embedding and the vision tower stay bf16.
#   - The lm_head int8 unrotated with a bf16 scale per (row, 128) (logits_gemm_i8).
#   - The MTP head's 2-bit copy of the lm_head (u2 codes, an f16 scale and a u8 zero a group of
#     128), which the draft rounds read in place of the full head.

blk.*.attn_qg.weight                 rtn  codes=i8 group=256 scale=u8 scale2=bf16 block2=1x* transform=fwht128 clamp=sym rule=search
blk.*.attn_k.weight                  rtn  codes=i8 group=256 scale=u8 scale2=bf16 block2=1x* transform=fwht128 clamp=sym rule=search
blk.*.attn_v.weight                  rtn  codes=i8 group=256 scale=u8 scale2=bf16 block2=1x* transform=fwht128 clamp=sym rule=search
blk.*.attn_output.weight             rtn  codes=i8 group=256 scale=u8 scale2=bf16 block2=1x* transform=fwht128 clamp=sym rule=search
blk.*.ssm_inz.weight                 rtn  codes=i8 group=256 scale=u8 scale2=bf16 block2=1x* transform=fwht128 clamp=sym rule=search
blk.*.ssm_out.weight                 rtn  codes=i8 group=256 scale=u8 scale2=bf16 block2=1x* transform=fwht128 clamp=sym rule=search

blk.*.ffn_gate_up_exps.*.weight      rtn  codes=i8 group=128 scale=bf16 transform=fwht128 clamp=sym rule=search
blk.*.ffn_down_exps.*.weight         rtn  codes=i8 group=128 scale=bf16 transform=fwht128 clamp=sym rule=search
blk.*.ffn_gate_up_shexp.weight       rtn  codes=i8 group=256 scale=u8 scale2=bf16 block2=1x* transform=fwht128 clamp=sym rule=search
blk.*.ffn_down_shexp.weight          rtn  codes=i8 group=128 scale=bf16 transform=fwht128 clamp=sym rule=search

output.weight                        rtn  codes=i8 group=128 scale=bf16 clamp=sym rule=search
mtp.draft_head.weight                rtn  codes=u2 zero=u8 group=128 scale=f16
