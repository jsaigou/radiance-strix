# gemma4-e4b-bf16-df.recipe -- Gemma 4 E4B (NVIDIA-Nemotron-3.5-Bolt-E4B-BF16) as the checkpoint holds it,
# text and vision, with NVIDIA's DFlash drafter at int8 (w8a8). Wikitext-2 KL against the HF bf16 reference
# 0.0015 (bf16 against fp32 0.0012).
#
#   rad-convert <checkpoint> --recipe data/recipes/gemma4-e4b-bf16-df.recipe --draft-model <dflash-bf16> \
#       --set quantization_config.quant_method=compressed-tensors -o nemotron-3.5-bolt-e4b-bf16.rad
#
# The drafter ships as a GGUF only (nvidia/NVIDIA-Nemotron-3.5-Bolt-E4B-4GB-DFlash); --draft-model reads
# it as safetensors in the z-lab layout. The drafter's linears and head are int8 with an f16 scale per row and 128 of K.

dflash.fc.weight                 rtn codes=i8 group=128 scale=f16 clamp=sym
dflash.blk.*.attn_q.weight       rtn codes=i8 group=128 scale=f16 clamp=sym
dflash.blk.*.attn_k.weight       rtn codes=i8 group=128 scale=f16 clamp=sym
dflash.blk.*.attn_v.weight       rtn codes=i8 group=128 scale=f16 clamp=sym
dflash.blk.*.attn_output.weight  rtn codes=i8 group=128 scale=f16 clamp=sym
dflash.blk.*.ffn_gate_up.weight  rtn codes=i8 group=128 scale=f16 clamp=sym
dflash.blk.*.ffn_down.weight     rtn codes=i8 group=128 scale=f16 clamp=sym
dflash.draft_head.weight         rtn codes=i8 group=128 scale=f16 clamp=sym
